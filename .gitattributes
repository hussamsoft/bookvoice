# Normalize all text files to LF in the repo; git handles checkout EOL.
* text=auto

# Vite rewrites the HTML template's line endings during the build. From a
# CRLF checkout it emits a doubled carriage return into dist/index.html, so
# the built bundle stops matching the committed one and CI's static-sync
# check fails on Windows only. Pinning the build input to LF keeps the
# build output byte-stable on every platform.
frontend/index.html text eol=lf

# Windows scripts and solutions keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf

# Binaries — never normalize
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.wav binary
*.mp3 binary
*.flac binary
*.ogg binary
*.pdf binary
*.zip binary
*.msi binary
*.cab binary
*.exe binary
*.dll binary
*.pyd binary
*.node binary
*.safetensors binary
*.onnx binary
*.pt binary
*.blend binary
