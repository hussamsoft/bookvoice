{
    "name": "bookvoice",
    "private": true,
    "version": "2.6.1",
    "description": "Read with your ears — local-first PDF reader with TTS and voice cloning",
    "main": "electron/main.js",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "oxlint",
        "test": "vitest run",
        "preview": "vite preview",
        "electron:dev": "NODE_ENV=development electron .",
        "electron:build": "npm run build && electron-builder"
    },
    "build": {
        "appId": "com.bookvoice.app",
        "productName": "BookVoice",
        "files": [
            "dist/**/*",
            "electron/**/*"
        ],
        "directories": {
            "output": "release"
        },
        "win": {
            "target": "portable",
            "icon": "build/icon.ico"
        },
        "portable": {
            "artifactName": "BookVoice-Setup.exe"
        }
    },
    "dependencies": {
        "@fontsource-variable/fraunces": "^5.3.0",
        "@fontsource-variable/literata": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/ibm-plex-sans": "^5.3.0",
        "@fontsource/noto-naskh-arabic": "^5.3.0",
        "lucide-react": "^1.23.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-pdf": "^10.4.1"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "electron": "^44.0.0",
        "electron-builder": "^26.15.3",
        "jsdom": "^29.1.1",
        "oxlint": "^1.71.0",
        "vite": "^8.1.1",
        "vitest": "^4.1.10"
    }
}
