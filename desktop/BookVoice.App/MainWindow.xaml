<Window
    x:Class="BookVoice.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BookVoice.App"
    Title="BookVoice">

    <Grid x:Name="Root">

        <!-- Startup splash: shown while the backend process warms up. -->
        <Grid x:Name="SplashPanel" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel
                MaxWidth="440"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <Image
                    Height="72"
                    HorizontalAlignment="Center"
                    Source="Assets/bookvoice.png" />
                <TextBlock
                    x:Name="SplashTitle"
                    HorizontalAlignment="Center"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="Starting BookVoice" />
                <TextBlock
                    x:Name="SplashDetail"
                    HorizontalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    Text="Waiting for startup checks…"
                    TextWrapping="Wrap" />
                <ProgressBar
                    x:Name="SplashProgress"
                    IsIndeterminate="False"
                    Maximum="100"
                    Value="5" />
                <TextBlock
                    x:Name="SplashFooter"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="Local desktop app · BookVoice" />
            </StackPanel>
        </Grid>

        <!-- Startup failure: message, technical log tail, recovery actions. -->
        <Grid
            x:Name="ErrorPanel"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel
                    MaxWidth="680"
                    Margin="48,40,48,40"
                    VerticalAlignment="Center"
                    Spacing="14">
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="36"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xE783;" />
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="BookVoice could not open" />
                    <TextBlock
                        x:Name="ErrorMessage"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Header="Technical details">
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                x:Name="ErrorLog"
                                FontFamily="Consolas"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Expander>
                    <HyperlinkButton
                        x:Name="RuntimeHelpLink"
                        Content="Get the WebView2 Runtime"
                        NavigateUri="https://go.microsoft.com/fwlink/p/?LinkId=2124703"
                        Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="RetryButton"
                            Click="OnRetryClick"
                            Content="Try again"
                            Style="{ThemeResource AccentButtonStyle}" />
                        <Button
                            x:Name="OpenLogsButton"
                            Click="OnOpenLogsClick"
                            Content="Open log folder" />
                        <Button
                            x:Name="CloseAppButton"
                            Click="OnCloseClick"
                            Content="Close" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- The app itself, served by the local backend. -->
        <Grid x:Name="ContentPanel" Visibility="Collapsed">
            <WebView2
                x:Name="Web"
                DefaultBackgroundColor="#F7F5F1" />
        </Grid>

    </Grid>
</Window>
