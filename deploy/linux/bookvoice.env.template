# BookVoice server environment — rendered by deploy/linux/install.sh and read
# by the systemd unit via EnvironmentFile. Values in {{...}} are substituted at
# install time; everything else is a real value or a commented option.
#
# After editing this file: sudo systemctl restart bookvoice
# (or: systemctl --user restart bookvoice)

# --- Storage -----------------------------------------------------------------
# Sessions, cloned voices, book archives, Studio projects, prepared books.
DATA_DIR={{DATA_DIR}}
# Local model weights root. English TTS weights must live at $MODEL_DIR/en/
# (presence detected by tokenizer.json). The multilingual model (~3 GB)
# downloads into $DATA_DIR/hf on first non-English narration.
MODEL_DIR={{MODEL_DIR}}
# Where cloned voices live. Defaults to $DATA_DIR/voices when unset.
VOICE_DATA_DIR={{VOICE_DATA_DIR}}
# Seed voices copied into $VOICE_DATA_DIR on startup (existing files untouched).
DEFAULT_VOICES_DIR={{DEFAULT_VOICES_DIR}}
# Writable caches (the unit hardens the rest of the filesystem read-only).
HF_HOME={{DATA_DIR}}/hf
EASYOCR_MODULE_PATH={{DATA_DIR}}/easyocr

# --- Server mode -------------------------------------------------------------
# Marks this as a hosted server: hides Save-to-Downloads / Open Folder in the
# UI and refuses them server-side. Must stay 1 for a server install.
BOOKVOICE_SERVER_MODE=1
# Password gate. Unset/empty means no login — never do that on anything
# reachable beyond loopback.
BOOKVOICE_ACCESS_PASSWORD={{ACCESS_PASSWORD}}
# Bind address and port. main.py does not read these; the systemd unit expands
# them into `uvicorn main:app --host ${BOOKVOICE_HOST} --port ${BOOKVOICE_PORT}`.
# 0.0.0.0 exposes the instance to the network — keep the password set.
BOOKVOICE_HOST={{HOST}}
BOOKVOICE_PORT={{PORT}}
# The exact origin browsers use, e.g. https://bookvoice.example.com — required
# once the app is behind a domain/TLS, or every API call is rejected by the
# browser-origin check. Leave commented while on plain http://host:8000.
#BOOKVOICE_PUBLIC_ORIGIN=https://bookvoice.example.com
# Extra CORS origins as a JSON array (the public origin is trusted automatically).
#CORS_ORIGINS=["https://bookvoice.example.com"]
# The session cookie is Secure by default (browsers drop it over plain HTTP).
# Set to 0 only for local plain-HTTP testing.
#BOOKVOICE_COOKIE_SECURE=0
# Optional explicit session-signing key. Defaults to a key derived from the
# password, so changing the password signs everyone out.
#BOOKVOICE_SECRET_KEY=

# --- Features ----------------------------------------------------------------
# EasyOCR on NVIDIA GPU (needs the --cuda install profile): 1 to enable,
# 0 forces CPU. Empty/unset defers to the in-app setting (default CPU).
OCR_USE_GPU={{OCR_USE_GPU}}
# Where to look for ffmpeg/ffprobe if not on PATH (Linux uses PATH by default).
#BOOKVOICE_MEDIA_TOOLS_DIR=/usr/local/bin

PYTHONUNBUFFERED=1
