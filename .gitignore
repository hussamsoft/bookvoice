# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node
node_modules/
frontend/dist/
frontend/release/
dist-ssr/
*.local
frontend/tmp/
# Python
__pycache__/
*.py[cod]
*.class
.venv/
venv/
ENV/
env/
test_venv*/
.env
.env.*
!.env.example
# Release build input asserted by tests/test_build_release.py; contains only
# same-origin VITE paths, never secrets.
!frontend/.env.production

# Generated Data
backend/data/

# Media
*.wav
# ...except committed test fixtures
!tests/fixtures/*.wav

tools/python-embed/
# Pinned FFmpeg/FFprobe staging copy (~194 MB of binaries). Not a source
# input: build.py resolves them from BOOKVOICE_MEDIA_TOOLS_SOURCE, PATH, or
# a previous dist payload (scripts/stage_media_tools.py).
tools/ffmpeg/

build/
*.spec
!Launcher.spec

# MSI build output (installer/*.msi, WiX intermediates, cabs) — regenerate
# with build_msi.py / package_msi.bat; too large and derivable to commit.
installer/

# Local tool state unrelated to the app.
.zcode/

# dist/ is fully generated by build.py (app payload, static bundle,
# manifests, launcher). It is intentionally NOT tracked: binaries churned
# every release (~35 MB Launcher.exe) and repeatedly drifted from source.
# Rebuild locally with `python build.py`; releases ship via GitHub Releases.
/dist/

# Local scratch and private material that must never be committed.
# "Old Docs" holds personal keys/certs (e.g. auto.key) unrelated to the app.
.pytest_tmp/
Old Docs/
backend/data-e2e/
.venv-linux/

# Stray Windows icon-cache artifacts accidentally committed in v2.4.1
# (ProgramData/Microsoft/Windows/Caches/*.db). Nothing in the tree needs
# them; ignore the whole directory so a path-expansion slip cannot re-add it.
%SystemDrive%/

# Keep the committed, preloaded default voices (override the global *.wav rule)
!voices/*.wav
