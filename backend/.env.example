# Backend Configuration (main.py reads none of these for its bind port —
# the launcher picks a free 8000-8020 port and passes --port to uvicorn).
CORS_ORIGINS=["http://localhost:8000", "http://localhost:8001"]

# Set to "true" to run OCR on GPU (uses extra VRAM alongside TTS)
OCR_USE_GPU=false

# Required for a hosted deployment that should accept browser requests from a
# public origin. List the exact browser origins (scheme + host [+ port]) that
# BookVoice should trust, comma- or space-separated. The desktop app leaves
# this empty and stays loopback-only. Example:
#   BOOKVOICE_PUBLIC_ORIGIN="https://bookvoice.example.com"
# Listing a non-loopback origin here is the only way to let a remote browser
# through the origin policy without opening the API to DNS rebinding; keep
# the list as small as the deployment actually uses.
BOOKVOICE_PUBLIC_ORIGIN=

# Set to "true" to let LAN browsers call the API (e.g. a phone on the same
# Wi-Fi). Off by default; the launcher turns it on when bound beyond loopback.
# Enabling it here without an external bound port is not enough — the bind
# address still has to come from the launcher flags.
BOOKVOICE_ALLOW_PRIVATE_ORIGINS=false

# When BookVoice sits behind a reverse proxy that terminates TLS, set this to
# "true" so the X-Forwarded-Proto header is honored when computing the
# trusted-origin set. Leave it "false" for any port exposed directly on the
# internet, where clients can forge the header.
BOOKVOICE_TRUST_PROXY_HEADERS=false

# Optional password gate for hosted deployments. Leave empty for the desktop
# app. When set, every API request must carry a signed session cookie obtained
# by POSTing the password to /api/access. Minimum length: 8 characters.
BOOKVOICE_ACCESS_PASSWORD=
